API_PORT=4100
WEB_PORT=4173
VITE_API_BASE_URL=http://localhost:4100
HEARTBEAT_INTERVAL_MS=3000
REDIS_URL=redis://127.0.0.1:6380
WORKER_EXECUTION_MODE=provider
WORKER_PROVIDER=hermes
WORKER_VERIFICATION_BACKEND=docker
ULTIMATE_SYSTEM_DATA_DIR=./data
ULTIMATE_SYSTEM_DB_PATH=./data/ultimate-system.db
OPENAI_MODEL=gpt-5.4
# Set OPENAI_API_KEY when WORKER_EXECUTION_MODE=provider
# OPENAI_API_KEY=
# Optional direct Hermes gateway overrides:
HERMES_API_HOST=127.0.0.1
HERMES_API_PORT=8642
HERMES_API_KEY=ultimate-system-hermes-dev-key
# Optional direct OpenClaw gateway overrides:
OPENCLAW_GATEWAY_HOST=127.0.0.1
OPENCLAW_GATEWAY_PORT=28789
OPENCLAW_GATEWAY_TOKEN=ultimate-system-openclaw-dev-key
OPENCLAW_HOME_DIR=./data/openclaw-home
OPENCLAW_AGENT_ID=ultimate-system
OPENCLAW_AGENT_MODEL=openai/gpt-4o-mini
# Optional direct Paperclip integration overrides:
PAPERCLIP_URL=http://127.0.0.1:3100

# Optional ReliantAI integration overrides:
# RELIANTAI_AUTH_URL=http://localhost:8080/verify
# RELIANTAI_EVENT_BUS_URL=http://localhost:8081/publish
# RELIANTAI_AGENT_URL=http://localhost:8082/agent
# WebAuthn / passkey relying-party configuration:
AUTH_RP_NAME=Ultimate System
AUTH_RP_IDS=localhost
AUTH_ORIGINS=http://localhost:4173
# Verification sandbox image used by the worker and upstream Hermes gateway:
TERMINAL_DOCKER_IMAGE=node:22-bookworm
# Bootstrap login for the local control plane:
ULTIMATE_SYSTEM_ADMIN_EMAIL=admin@ultimate-system.local
ULTIMATE_SYSTEM_ADMIN_PASSWORD=change-this-password
ULTIMATE_SYSTEM_ADMIN_NAME=LocalAdmin
ULTIMATE_SYSTEM_REQUESTER_EMAIL=requester@ultimate-system.local
ULTIMATE_SYSTEM_REQUESTER_PASSWORD=requester-password
ULTIMATE_SYSTEM_REQUESTER_NAME=LocalRequester
ULTIMATE_SYSTEM_APPROVER_EMAIL=approver@ultimate-system.local
ULTIMATE_SYSTEM_APPROVER_PASSWORD=approver-password
ULTIMATE_SYSTEM_APPROVER_NAME=LocalApprover
ULTIMATE_SYSTEM_VIEWER_EMAIL=viewer@ultimate-system.local
ULTIMATE_SYSTEM_VIEWER_PASSWORD=viewer-password
ULTIMATE_SYSTEM_VIEWER_NAME=LocalViewer
# Optional override for the Responses API endpoint:
# OPENAI_RESPONSES_URL=https://api.openai.com/v1/responses
