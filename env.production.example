# Production Environment Configuration
# Copy this to .env.production and update values

# ============================================
# CORE SETTINGS (Required)
# ============================================
NODE_ENV=production
DATABASE_URL=/data/ultimate-system.db
REDIS_URL=redis://redis:6379
UNIFIED_PORT=8888

# ============================================
# SECURITY (Required - CHANGE THESE!)
# ============================================
# Session secret for cookie signing - generate with: openssl rand -base64 32
SESSION_SECRET=change-this-to-a-32-character-secret-key-here

# WebAuthn configuration - update with your actual domain
AUTH_RP_NAME=Ultimate System
AUTH_RP_IDS=your-domain.com
AUTH_ORIGINS=https://your-domain.com

# ============================================
# BOOTSTRAP ACCOUNTS (Required - CHANGE PASSWORDS!)
# ============================================
ULTIMATE_SYSTEM_ADMIN_EMAIL=admin@your-domain.com
ULTIMATE_SYSTEM_ADMIN_PASSWORD=change-this-production-password
ULTIMATE_SYSTEM_ADMIN_NAME=Administrator

ULTIMATE_SYSTEM_REQUESTER_EMAIL=requester@your-domain.com
ULTIMATE_SYSTEM_REQUESTER_PASSWORD=change-this-production-password
ULTIMATE_SYSTEM_REQUESTER_NAME=Requester

ULTIMATE_SYSTEM_APPROVER_EMAIL=approver@your-domain.com
ULTIMATE_SYSTEM_APPROVER_PASSWORD=change-this-production-password
ULTIMATE_SYSTEM_APPROVER_NAME=Approver

ULTIMATE_SYSTEM_VIEWER_EMAIL=viewer@your-domain.com
ULTIMATE_SYSTEM_VIEWER_PASSWORD=change-this-production-password
ULTIMATE_SYSTEM_VIEWER_NAME=Viewer

# ============================================
# AI PROVIDER API KEYS (Required for provider mode)
# ============================================
# Uncomment and set the provider you want to use:
# OPENAI_API_KEY=sk-...
# OPENROUTER_API_KEY=sk-or-...
# DEEPSEEK_API_KEY=...

# ============================================
# OPTIONAL: External Service Configuration
# ============================================
# Uncomment if using external integrations:

# Hermes Gateway (for provider execution mode)
# HERMES_API_HOST=hermes.your-domain.com
# HERMES_API_PORT=8642
# HERMES_API_KEY=your-production-hermes-key

# OpenClaw Gateway
# OPENCLAW_GATEWAY_HOST=openclaw.your-domain.com
# OPENCLAW_GATEWAY_PORT=28789
# OPENCLAW_GATEWAY_TOKEN=your-production-openclaw-token
# OPENCLAW_AGENT_MODEL=openai/gpt-4o

# Paperclip Integration
# PAPERCLIP_URL=https://paperclip.your-domain.com

# Revenue Orchestrator (if using)
# REVENUE_AUTO_START=true
# REVENUE_MAX_DAILY_TASKS=100
# APEX_MCP_ENDPOINT=https://apex.your-domain.com
# CLEARDESK_ENDPOINT=https://clear-desk.your-domain.com
# MONEY_ENDPOINT=https://money.your-domain.com

# ============================================
# OPTIONAL: Performance Tuning
# ============================================
HEARTBEAT_INTERVAL_MS=3000
WORKER_EXECUTION_MODE=deterministic
WORKER_VERIFICATION_BACKEND=docker
TERMINAL_DOCKER_IMAGE=node:22-bookworm

# ============================================
# OPTIONAL: Monitoring
# ============================================
# Enable Prometheus metrics endpoint
# METRICS_ENABLED=true
# METRICS_PORT=9090