[Unit]
Description=Ultimate System Control Plane
Documentation=https://github.com/anomalyco/ultimate-system
After=network.target redis.service

[Service]
Type=simple
User=ultimate
Group=ultimate
WorkingDirectory=/opt/ultimate-system
ExecStart=/usr/bin/node apps/control-plane/dist/server.js
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ultimate-control-plane

# Environment
EnvironmentFile=/opt/ultimate-system/.env

# Security
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/ultimate-system/data

# Resource Limits
LimitNOFILE=65536
MemoryMax=2G

[Install]
WantedBy=multi-user.target