# pnpm configuration for Vercel builds
# Allow build scripts for native dependencies

# Automatically approve builds for packages that need compilation
auto-install-peers=true
strict-peer-dependencies=false

# Allow build scripts (required for native modules like better-sqlite3, esbuild)
# This is safe because we control the lockfile and review dependencies
enable-pre-post-scripts=true

# Configure which packages can run install scripts
# These packages require native compilation and are trusted
ignore-scripts=false

# Note: For Vercel, we set the environment variable:
# PNPM_IGNORE_PACKAGE_MANAGER_VERSION=false
# And use: pnpm install --frozen-lockfile